# The Euler scan is too crude - piecewise masses look wrong. Use proper RK4.
import numpy as np

G = 6.674e-8
K1 = 1e5; Gamma1 = 1.8; Gamma2 = 2.5; rho_t = 1e9
P_t = K1 * rho_t**Gamma1
K2  = P_t / rho_t**Gamma2
M_sun = 1.989e33

def rho_of_P_pw(P):
    return (P/K1)**(1/Gamma1) if P <= P_t else (P/K2)**(1/Gamma2)

def rho_of_P_single(P):
    return (max(P,0)/K1)**(1/Gamma1)

def solve(Pc, rho_from_P, N=20000):
    r_arr = np.linspace(1e-6, 2e6, N)
    dr = r_arr[1] - r_arr[0]
    r, m, P = r_arr[0], 1e-10, Pc
    for _ in r_arr:
        if P < 1e-10 * Pc: break
        def deriv(r_, m_, P_):
            rh = rho_from_P(max(P_,0.0))
            return 4*np.pi*r_**2*rh, (-G*m_*rh/r_**2 if r_>0 else 0.0)
        k1m,k1P = deriv(r,      m,          P)
        k2m,k2P = deriv(r+dr/2, m+dr*k1m/2, P+dr*k1P/2)
        k3m,k3P = deriv(r+dr/2, m+dr*k2m/2, P+dr*k2P/2)
        k4m,k4P = deriv(r+dr,   m+dr*k3m,   P+dr*k3P)
        m += dr/6*(k1m+2*k2m+2*k3m+k4m)
        P += dr/6*(k1P+2*k2P+2*k3P+k4P)
        P = max(P, 0.0); r += dr
    return m

# First: survey both models to find max masses
Pc_vals = np.logspace(33, 40, 80)
ms = np.array([solve(Pc, rho_of_P_single) for Pc in Pc_vals])
mp = np.array([solve(Pc, rho_of_P_pw)     for Pc in Pc_vals])

print("=== Mass survey ===")
for i in range(0, len(Pc_vals), 10):
    print(f"Pc={Pc_vals[i]:.1e}  single={ms[i]/M_sun:.4f}  pw={mp[i]/M_sun:.4f} Msun")

print(f"\nSingle max: {ms.max()/M_sun:.3f} Msun at Pc={Pc_vals[ms.argmax()]:.2e}")
print(f"Piecewise max: {mp.max()/M_sun:.3f} Msun at Pc={Pc_vals[mp.argmax()]:.2e}")
