import numpy as np

G = 6.674e-8
K1 = 1e5; Gamma1 = 1.8; Gamma2 = 2.5; rho_t = 1e9
P_t = K1 * rho_t**Gamma1
K2  = P_t / rho_t**Gamma2
M_sun = 1.989e33

def rho_of_P_pw(P):
    return (P/K1)**(1/Gamma1) if P <= P_t else (P/K2)**(1/Gamma2)

def rho_of_P_single(P):
    return (max(P,0)/K1)**(1/Gamma1)

def solve(Pc, rho_from_P, N=30000):
    r_arr = np.linspace(1e-6, 2e6, N)
    dr = r_arr[1] - r_arr[0]
    r, m, P = r_arr[0], 1e-10, Pc
    for _ in r_arr:
        if P < 1e-10 * Pc: break
        rh = rho_from_P(max(P, 0.0))
        dm = 4*np.pi*r**2*rh
        dP = -G*m*rh/r**2 if r > 0 else 0.0
        # simple euler for speed in scan
        m += dr*dm; P += dr*dP
        P = max(P, 0.0); r += dr
    return m

Pc_scan = np.logspace(33, 44, 300)
ms = np.array([solve(Pc, rho_of_P_single) for Pc in Pc_scan])
mp = np.array([solve(Pc, rho_of_P_pw)     for Pc in Pc_scan])

print("Single polytrope max mass: {:.3f} Msun at Pc={:.2e}".format(
    ms.max()/M_sun, Pc_scan[ms.argmax()]))
print("Piecewise max mass:        {:.3f} Msun at Pc={:.2e}".format(
    mp.max()/M_sun, Pc_scan[mp.argmax()]))

# common mass = 0.3 Msun (well within both)
for Mtarget_frac in [0.1, 0.3]:
    Mt = Mtarget_frac * M_sun
    # single: find on ascending branch (before max)
    imax_s = ms.argmax()
    imax_p = mp.argmax()
    idx_s = np.argmin(np.abs(ms[:imax_s] - Mt))
    idx_p = np.argmin(np.abs(mp[:imax_p] - Mt))
    print(f"\nM = {Mtarget_frac} Msun:")
    print(f"  Single    Pc = {Pc_scan[idx_s]:.3e}")
    print(f"  Piecewise Pc = {Pc_scan[idx_p]:.3e}")
    print(f"  Ratio = {Pc_scan[idx_s]/Pc_scan[idx_p]:.1e}")
